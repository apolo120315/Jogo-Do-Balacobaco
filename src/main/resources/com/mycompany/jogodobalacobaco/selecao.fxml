<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogodobalacobaco.SelecaoHistoriaController">
    
    <ImageView fitWidth="640" fitHeight="480" preserveRatio="false">
        <image>
            <Image url="@imagens/menu.gif" />
        </image>
    </ImageView>
    
    <VBox alignment="CENTER">
        <children>
        <HBox alignment="CENTER">
            <StackPane maxWidth="320.0" maxHeight="380.0"> <!-- Estante 1 -->
                <children>
                    
                        <ImageView fitWidth="640" fitHeight="480" preserveRatio="false">
                            <image>
                                <Image url="@imagens/EstanteDireita.png" />
                            </image>
                        </ImageView>
                    
                     <HBox alignment="CENTER_LEFT" spacing="15.0"> <!-- Livros -->
                            <Button fx:id="H1" onAction="#MundoOriental" prefWidth="180.0" prefHeight="100.0" text="" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;">
                                <graphic>
                                    <ImageView fitWidth="160" fitHeight="90" preserveRatio="true">
                                        <image>
                                            <Image url="@imagens/templo.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                          </HBox>
                </children>
            </StackPane>
        
            <StackPane maxWidth="320.0" maxHeight="380.0"> <!-- Estante 2 -->
                 <children>
                    
                        <ImageView fitWidth="640" fitHeight="480" preserveRatio="false">
                            <image>
                                <Image url="@imagens/EstanteEsquerda.png" />
                            </image>
                        </ImageView>

                          <HBox alignment="CENTER_RIGHT" spacing="15.0">  <!-- Livros -->
                            <Button fx:id="H2" onAction="#MundoMagia" prefWidth="180.0" prefHeight="100.0" text="" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;">
                                <graphic>
                                    <ImageView fitWidth="160" fitHeight="90" preserveRatio="true">
                                        <image>
                                            <Image url="@imagens/torreMagica.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                          </HBox>  
                       </children>
            </StackPane>
        </HBox>
                    <Button fx:id="Voltar" text="Voltar" onAction="#voltarAoMenu" prefWidth="180.0" />            
        </children>
    </VBox>
</StackPane>