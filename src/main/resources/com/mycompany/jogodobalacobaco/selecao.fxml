<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogodobalacobaco.SelecaoHistoriaController">
    
    <ImageView fitWidth="640" fitHeight="480" preserveRatio="false">
        <image>
            <Image url="@imagens/menu.gif" />
        </image>
    </ImageView>
    
    <HBox alignment="CENTER">
        <children>
            
            <StackPane maxWidth="320.0" maxHeight="380.0">
                 <children>
                    
                    <Region style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 15px; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 15px; -fx-border-width: 1.5px;">
                       <effect>
                          <DropShadow radius="15.0" color="rgba(0,0,0,0.3)" />
                       </effect>
                    </Region>
                    
                    <VBox alignment="CENTER" spacing="15.0">
                       <padding>
                          <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                       </padding>
                       <children>
                          <Label text="Selecione sua história" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 5, 0, 0, 1);" />
                          <HBox alignment="CENTER" spacing="15.0">
                            <Button fx:id="H1" onAction="#MundoOriental" prefWidth="180.0" prefHeight="100.0" text="" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;">
                                <graphic>
                                    <ImageView fitWidth="160" fitHeight="90" preserveRatio="true">
                                        <image>
                                            <Image url="@imagens/templo.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="H2" onAction="#MundoMagia" prefWidth="180.0" prefHeight="100.0" text="" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;">
                                <graphic>
                                    <ImageView fitWidth="160" fitHeight="90" preserveRatio="true">
                                        <image>
                                            <Image url="@imagens/torreMagica.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="Voltar" text="Voltar" onAction="#voltarAoMenu" prefWidth="180.0" />
                          </HBox>  
                       </children>
                    </VBox>
                    
                 </children>
            </StackPane>
            
        </children>
    </HBox>
</StackPane>